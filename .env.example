# Claude (Anthropic API)
ANTHROPIC_API_KEY=

# PayPal REST app credentials (sandbox only: this MVP refuses live endpoints)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional
# SUPPLORA_MODEL=claude-opus-5-5
# Send every supplier payout to one sandbox account you own (e.g. a sandbox personal
# account from developer.paypal.com > Sandbox > Accounts) so items end as SUCCESS
# instead of UNCLAIMED. Leave empty to use the per-supplier emails in src/data/seed.ts.
# PAYPAL_PAYOUT_RECEIVER_OVERRIDE=
# Verified PayPal webhooks: the id printed by scripts/register-webhook.mjs for this app and URL
# (see docs/DEPLOY.md). Unset: /api/paypal/webhook answers 503.
# PAYPAL_WEBHOOK_ID=
# Business date used by the demo (the sample invoices are dated around it).
# DEMO_TODAY=2026-10-16

# Keyless public demo (see docs/DEPLOY.md): replay recorded Claude runs, per-visitor sessions,
# live PayPal sandbox. ANTHROPIC_API_KEY is not used when this is on.
# DEMO_MODE=1
# Vercel only: Upstash Redis for demo sessions (either naming works).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local only, with real keys: record Claude's outputs to src/data/recorded/ for the demo.
# RECORD_DEMO=1

# /ledger/studio (AG Studio). Licence key for AG Studio (a free 45-day trial key from
# ag-grid.com/studio/license-pricing); unset, Studio runs as a trial with a watermark.
# AG_STUDIO_LICENSE_KEY=
# Studio's chat calls Claude live when a key is set and DEMO_MODE is off. On the public demo
# it replays the recorded runs in src/data/recorded/studio-runs.json, unless STUDIO_AI_LIVE=1
# turns live turns on (capped per visitor). STUDIO_AI=off hides the chat.
# STUDIO_AI_LIVE=1
# STUDIO_AI=off
# STUDIO_AI_MODEL=claude-opus-5-5
# Recording Studio runs: RECORD_DEMO=1 on a dev server, open /ledger/studio?record=1, run the
# suggested prompts, then "Save recorded runs".
